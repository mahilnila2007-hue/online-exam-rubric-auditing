# ============================================================
# Online Examination System with Rubric Auditing Mechanism
# Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=replace-with-a-long-random-hex-secret-key
SESSION_COOKIE_SECURE=false
SESSION_DURATION_HOURS=12

# Firebase Admin SDK (Backend ONLY - NEVER expose to frontend)
# Provide EITHER a file path to your service account JSON OR inline JSON string
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./secrets/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Optional: Firebase Local Emulator Suite hosts (for local testing without cloud)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Firebase Web Client SDK (Public frontend config from Firebase Console -> Project Settings)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX

